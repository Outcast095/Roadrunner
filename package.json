{
  "name": "roadrunner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:3d": "eslint \"**/*3d*\" \"**/*webgl*\" \"**/*three*\" \"**/shaders/**/*\" \"**/scenes/**/*\"",
    "lint:3d:fix": "eslint \"**/*3d*\" \"**/*webgl*\" \"**/*three*\" \"**/shaders/**/*\" \"**/scenes/**/*\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:3d": "prettier --write \"**/*3d*\" \"**/*webgl*\" \"**/*three*\" \"**/shaders/**/*\" \"**/scenes/**/*\"",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "prepare": "husky"
  },
  "dependencies": {
    "@babylonjs/core": "^8.27.2",
    "@babylonjs/loaders": "^8.27.2",
    "@babylonjs/materials": "^8.27.2",
    "@playwright/test": "^1.55.0",
    "ammo.js": "^0.0.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "sass": "^1.92.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
